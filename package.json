{
  "name": "@lupinum/nuxt-pdf",
  "version": "0.1.0",
  "description": "Author and render PDFs with Vue components in Nuxt",
  "repository": "github:Mat4m0/nuxt-pdf",
  "license": "MIT",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./test": {
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "CONFORMANCE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build": "nuxt-module-build build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:dependencies": "node scripts/check-production-dependencies.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:production": "vitest run --config vitest.production.config.ts",
    "test:quickstart": "node scripts/test-package-quickstart.mjs",
    "test:serverless": "vitest run --config vitest.serverless.config.ts",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && nuxt prepare test/fixtures/basic && vue-tsc --noEmit -p test/fixtures/basic/tsconfig.json && pnpm --dir playground exec vue-tsc --noEmit",
    "verify": "pnpm lint && pnpm test:types && pnpm test:dependencies && pnpm test && pnpm test:production && pnpm test:serverless && pnpm build && pnpm dev:build && pnpm test:package && pnpm test:quickstart"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@react-pdf/font": "4.0.8",
    "@react-pdf/layout": "4.6.1",
    "@react-pdf/pdfkit": "5.1.1",
    "@react-pdf/primitives": "4.3.0",
    "@react-pdf/render": "4.5.1",
    "@vue/compiler-sfc": "3.5.40",
    "esbuild": "0.28.1",
    "h3": "1.15.11"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "^5.6.205",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.97",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@react-pdf/renderer": "4.5.1",
    "@types/node": "latest",
    "@types/react": "19.2.14",
    "changelogen": "^0.6.2",
    "eslint": "^10.4.1",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "5.6.205",
    "react": "19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.3"
  }
}
