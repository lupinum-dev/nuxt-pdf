{
  "name": "@lupinum/nuxt-pdf",
  "version": "0.3.0",
  "description": "Author and render PDFs with Vue components in Nuxt",
  "keywords": [
    "nuxt",
    "pdf",
    "vue",
    "server-rendering",
    "document-generation"
  ],
  "homepage": "https://nuxt-pdf.lupinum.com",
  "bugs": {
    "url": "https://github.com/lupinum-dev/nuxt-pdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/nuxt-pdf.git"
  },
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./test": {
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "API_REPORT.md",
    "CHANGELOG.md",
    "CONFORMANCE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "prepack": "pnpm build",
    "prepublishOnly": "node scripts/block-source-publish.mjs",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build": "nuxt prepare && nuxt-module-build build",
    "api:write": "node scripts/check-api-report.mjs --write",
    "docs:build": "pnpm --dir docs build",
    "docs:dev": "pnpm --dir docs dev",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "lint": "eslint .",
    "test": "pnpm test:prepare && vitest run",
    "test:api": "node scripts/check-api-report.mjs",
    "release:pack": "pnpm build && node scripts/check-release-artifact.mjs release-artifacts",
    "release:verify": "pnpm check && pnpm release:pack",
    "test:artifact": "node scripts/check-release-artifact.mjs",
    "test:dependencies": "node scripts/check-production-dependencies.mjs",
    "test:docs": "node scripts/check-documentation.mjs && pnpm --dir docs check",
    "test:package": "node scripts/check-package.mjs",
    "test:package-metadata": "node scripts/check-api-report.mjs",
    "test:performance": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.performance.config.ts",
    "test:prepare": "pnpm dev:prepare && nuxt prepare test/fixtures/layers",
    "test:production": "vitest run --config vitest.production.config.ts",
    "test:quickstart": "node scripts/test-package-quickstart.mjs",
    "test:raster": "vitest run --config vitest.raster.config.ts",
    "test:version-headings": "node scripts/check-version-headings.mjs",
    "test:serverless": "vitest run --config vitest.serverless.config.ts",
    "test:watch": "vitest watch",
    "typecheck": "nuxt prepare && vue-tsc --noEmit && nuxt prepare test/fixtures/basic && vue-tsc --noEmit -p test/fixtures/basic/tsconfig.json && pnpm test:prepare && pnpm --dir playground exec vue-tsc --noEmit",
    "check": "pnpm format:check && pnpm typecheck && pnpm test:docs && pnpm test:version-headings && pnpm test:dependencies && pnpm test && pnpm test:production && pnpm test:serverless && pnpm build && pnpm test:package-metadata && pnpm dev:build && pnpm test:artifact"
  },
  "dependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@nuxt/kit": "^4.4.8",
    "@react-pdf/font": "4.0.8",
    "@react-pdf/layout": "4.6.1",
    "@react-pdf/pdfkit": "5.1.1",
    "@react-pdf/primitives": "4.3.0",
    "@react-pdf/render": "4.5.1",
    "@vue/compiler-sfc": "3.5.40",
    "esbuild": "0.28.1",
    "h3": "1.15.11",
    "ufo": "1.6.4",
    "unimport": "6.3.0"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "^5.6.205",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@napi-rs/canvas": "0.1.97",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@react-pdf/renderer": "4.5.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "changelogen": "^0.6.2",
    "eslint": "^10.4.1",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "5.6.205",
    "publint": "^0.3.21",
    "react": "19.2.0",
    "source-code-pro": "2.42.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.3"
  }
}
