{
  "name": "nuxt-pdf-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "check": "pnpm check:snippets && pnpm check:contracts && pnpm check:theme && pnpm typecheck && pnpm check:doctor && pnpm build && pnpm check:links",
    "check:contracts": "node ../scripts/check-docs-contracts.mjs",
    "check:doctor": "ginko-content doctor .",
    "check:links": "ginko-content validate .",
    "check:snippets": "node ../scripts/check-docs-snippets.mjs",
    "check:theme": "node ../scripts/check-docs-theme.mjs",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lupinum/ginko-content": "1.0.0-beta.5",
    "@lupinum/ginko-docs": "0.4.0-rc.4",
    "nuxt": "4.5.2",
    "nuxt-site-config": "4.2.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "vue-tsc": "^2.2.0"
  }
}
