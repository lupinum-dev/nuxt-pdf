{
  "name": "nuxt-pdf-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "check": "pnpm check:snippets && pnpm check:theme && pnpm typecheck && pnpm check:doctor && pnpm build && pnpm check:links",
    "check:doctor": "ginko-content doctor .",
    "check:links": "ginko-content validate .",
    "check:snippets": "node ../scripts/check-docs-snippets.mjs",
    "check:theme": "node ../scripts/check-docs-theme.mjs",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lupinum/ginko-content": "https://pkg.pr.new/lupinum-dev/ginko-content/@lupinum/ginko-content@3879b02",
    "@lupinum/ginko-docs": "https://pkg.pr.new/lupinum-dev/ginko-docs/@lupinum/ginko-docs@89423b9",
    "nuxt": "^4.5.2",
    "nuxt-site-config": "4.1.2",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "vue-tsc": "^2.2.0"
  }
}
