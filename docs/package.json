{
  "name": "nuxt-pdf-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "check": "pnpm check:snippets && pnpm typecheck && pnpm check:doctor && pnpm build && pnpm check:links",
    "check:doctor": "ginko-content doctor .",
    "check:links": "ginko-content validate .",
    "check:snippets": "node ../scripts/check-docs-snippets.mjs",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lupinum/ginko-content": "0.3.2",
    "@lupinum/ginko-docs": "0.2.3",
    "nuxt": "^4.4.8",
    "nuxt-site-config": "4.1.2",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "vue-tsc": "^2.2.0"
  }
}
