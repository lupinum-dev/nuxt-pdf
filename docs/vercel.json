{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "buildCommand": "pnpm --dir .. docs:build",
  "outputDirectory": null,
  "git": {
    "deploymentEnabled": {
      "renovate/**": false,
      "changeset-release/**": false,
      "ci/**": false
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore.mjs . ../package.json ../pnpm-lock.yaml ../pnpm-workspace.yaml"
}
